# GitHub personal access token. Needs `repo` scope: it reads the PR diff, posts
# the review comment, sets the commit status, and authenticates the clone on a
# cold boot.
GITHUB_TOKEN=ghp_your_token_here

# Shared secret configured on the GitHub webhook. Every delivery is HMAC-signed
# with it and rejected if the digest does not match. Leaving this unset disables
# verification, which is fine for a local curl walkthrough and never fine in a
# deployment.
GITHUB_WEBHOOK_SECRET=generate_with_openssl_rand_hex_32

# Gemini API key. Used by both the embedding client (google-genai) and the chat
# model (langchain-google-genai), which both read this variable name.
GOOGLE_API_KEY=your_gemini_api_key

# Optional overrides
# REVIEW_MODEL=gemini-2.5-flash
# QDRANT_PATH=./qdrant_data

# PostgreSQL connection string. When set, every review is persisted for analytics.
# Without it the service still works — analytics endpoints return 503.
DATABASE_URL=postgresql://user:password@localhost:5432/pr_reviewer
